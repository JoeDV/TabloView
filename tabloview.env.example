# Your TabloView settings for Docker (see DOCKER.md). Copy this file to tabloview.env and change the
# values there; tabloview.env stays yours when you update TabloView with git pull.

# Your Tablo account, used to sign in the first time. TabloView doesn't save the password: once it's
# signed in you can remove these two lines.
TABLO_EMAIL=you@example.com
TABLO_PASSWORD=your-password

# Which Tablo, if your account has more than one (its name in Tablo's app, or its ID)
# TABLO_DEVICE=Living Room

# Let other devices at home use TabloView, with this PIN (4 to 6 digits): change it
TABLOVIEW_NETWORK=1
TABLOVIEW_PIN=1234

# Your own computer's address: it can change every setting (several: separate them with commas)
TABLOVIEW_ADMIN=192.168.1.50

# Your time zone, for the guide and exports' dates
TZ=America/New_York

# Only if the server has more than one graphics chip: the one to convert with
# TABLOVIEW_VAAPI_DEVICE=/dev/dri/renderD128
