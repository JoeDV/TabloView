<?xml version="1.0" encoding="utf-8"?>
<!-- Template for the Microsoft Store package; packaging/build-msix.ps1 fills in the {{...}} values.
     Identity Name / Publisher / PublisherDisplayName come from Partner Center > Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity Name="JoeDelVecchio.TabloViewforTabloTV"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>TabloView for TabloTV</DisplayName>
    <PublisherDisplayName>Joe Del Vecchio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="TabloView" Executable="TabloView.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TabloView for TabloTV"
        Description="Browse, play and schedule recordings on your Tablo DVR"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="TabloView" />
      </uap:VisualElements>
      <Extensions>
        <!-- Device > Start with Windows (app/startup.py); off until the user turns it on -->
        <desktop:Extension Category="windows.startupTask" Executable="TabloView.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TabloViewStartup" Enabled="false" DisplayName="TabloView for TabloTV" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
