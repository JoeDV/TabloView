# Shell scripts must keep Unix line endings or macOS can't run them
*.sh text eol=lf
# Developer tools (TABLOVIEW_DEV_TOOLS=1) stay out of the Mac and Linux downloads (git archive)
tools/ export-ignore
# Recorded test data for the commercial finder: not needed to run TabloView
tests/data/ export-ignore
# Docker files are read on Linux: Unix line endings (a stray \r would end up in the settings' values)
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
*.env.example text eol=lf
